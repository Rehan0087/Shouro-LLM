# Which provider to use for operator-note interpretation: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai) -- uses Structured Outputs (strict JSON schema)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (used when LLM_PROVIDER=anthropic) -- uses forced tool-use
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Port the service listens on
PORT=8000
